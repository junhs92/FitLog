# FitLog Pro - Environment Variables Template
# Copy this file to .env and fill in your actual values
# ⚠️ NEVER commit .env to version control!

# ===========================================
# Supabase Configuration
# ===========================================
# Get these from: https://supabase.com/dashboard → Your Project → Settings → API

# Project URL (format: https://xxxxx.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Anon/Public Key (for client-side use)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (for server-side/admin operations - KEEP SECRET!)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ===========================================
# GitHub Configuration (Optional - for MCP)
# ===========================================
# Get from: https://github.com/settings/tokens
# Scopes needed: repo, workflow

GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# AI Services (for workout generation)
# ===========================================
# OpenAI API Key - Required for AI workout generation
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# ExerciseDB API (for exercise GIF animations)
# ===========================================
# RapidAPI Key for ExerciseDB API - Used for exercise GIF animations
# Get from: https://rapidapi.com/exercisedb/api/exercisedb
RAPIDAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API Key (optional, for Claude)
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# Email Services (for report delivery)
# ===========================================
# Resend API Key - Required for sending session reports via email
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# App Configuration
# ===========================================
# Environment: development, staging, production
ENVIRONMENT=development

# App Version
APP_VERSION=1.0.0

# ===========================================
# Analytics (Optional)
# ===========================================
# Firebase Project ID
# FIREBASE_PROJECT_ID=fitlog-pro-xxxxx

# ===========================================
# Notes
# ===========================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values
# 3. .env is already in .gitignore
# 4. Each developer should have their own .env file
# 5. For production, use environment variables in your hosting platform
